{
    "target": "esp32s3",
    "builds": [
        {
            "name": "irille-s3-eye",
            "idf_version": ">=6.0.2",
            "sdkconfig_append": [
                "CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/8m.csv\"",
                "CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=n",
                "CONFIG_SR_WN_WN9_HIESP=y",
                "CONFIG_SR_WN_WN9_SOPHIA_TTS=n",
                "CONFIG_SR_WN_WN9_HEYILY_TTS2=n",
                "CONFIG_OTA_URL=\"http://192.168.1.48:8003/xiaozhi/ota/\"",
                "CONFIG_FLASH_CUSTOM_ASSETS=y",
                "CONFIG_CUSTOM_ASSETS_FILE=\"boards/irille-s3-eye/assets.bin\"",
                "CONFIG_CAMERA_OV2640=y",
                "CONFIG_CAMERA_OV2640_AUTO_DETECT_DVP_INTERFACE_SENSOR=y",
                "CONFIG_CAMERA_OV2640_DVP_JPEG_1600X1200_12FPS=y",
                "CONFIG_CAMERA_OV2640_DVP_DEFAULT_FMT_JPEG_1600X1200_12FPS=y",
                "CONFIG_XIAOZHI_CAMERA_ALLOW_JPEG_INPUT=y",
                "CONFIG_XIAOZHI_JPEG_DECODE_SCALE_WIDTH=320",
                "CONFIG_XIAOZHI_JPEG_DECODE_SCALE_HEIGHT=240",
                "CONFIG_LANGUAGE_IT_IT=y",
                "CONFIG_XIAOZHI_CAMERA_PREVIEW_FULL_WIDTH=y"
            ]
        }
    ]
}