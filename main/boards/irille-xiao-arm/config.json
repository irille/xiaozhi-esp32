{
    "target": "esp32s3",
    "builds": [
        {
            "name": "irille-xiao-arm",
            "idf_version": ">=6.0.2",
            "sdkconfig_append": [
                "CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/8m.csv\"",
                "CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y",
                "CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=n",
                "CONFIG_SR_WN_WN9_HIESP=y",
                "CONFIG_SR_WN_WN9_SOPHIA_TTS=n",
                "CONFIG_SR_WN_WN9_HEYILY_TTS2=n",
                "CONFIG_OTA_URL=\"http://192.168.1.48:8004/xiaozhi/ota/\"",
                "CONFIG_CAMERA_OV2640=n",
                "CONFIG_CAMERA_OV3660=y",
                "CONFIG_CAMERA_OV3660_AUTO_DETECT_DVP_INTERFACE_SENSOR=y",
                "CONFIG_CAMERA_OV3660_DVP_JPEG_640X480_25FPS=y",
                "CONFIG_CAMERA_OV3660_DVP_DEFAULT_FMT_JPEG_640X480_25FPS=y",
                "CONFIG_XIAOZHI_CAMERA_ALLOW_JPEG_INPUT=y"
            ]
        }
    ]
}
